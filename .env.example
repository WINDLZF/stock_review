# ── 应用 ──
SR_APP_NAME=stock-review
SR_LOG_LEVEL=INFO
# SQLite 零配置；切 Postgres 改此行即可：postgresql+psycopg://user:pwd@host:5432/stock
SR_DB_URL=sqlite:///./data/stock_review.db

# ── 配置加载 ──
SR_CONFIG_PATH=config.yaml

# ── 同花顺回写（cookie 由浏览器登录获取，切勿提交本文件）──
# 回写方式：http（调用同花顺开放 API）/ file（导出导入文件）
SR_THS_SYNC_MODE=http
# 同花顺接口基址（与获取 cookie 的平台一致）
SR_THS_API_BASE=
# 浏览器登录后拿到的 cookie（敏感，放本地 .env，已被 .gitignore 排除）
SR_THS_COOKIE=

# ── 可选数据源 token ──
SR_TUSHARE_TOKEN=
